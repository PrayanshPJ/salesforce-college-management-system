<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Valid_Marks</fullName>
    <active>true</active>
    <errorConditionFormula>OR(
    Marks__c &lt; 0,
    Marks__c &gt; 100
)</errorConditionFormula>
    <errorDisplayField>Marks__c</errorDisplayField>
    <errorMessage>Marks must be between 0 and 100.</errorMessage>
</ValidationRule>
